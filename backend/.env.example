# Copy to backend/.env for local development. Never commit the real file.

# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required in production: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me

# Browser origins allowed to upload files directly to the API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API whose X-Forwarded-For entry is trusted
# (0 for local development; see DEPLOYMENT.md for hosted values).
TRUSTED_PROXY_HOPS=0

# SQLite for local development; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# File storage: "local" for development, "s3" for any S3-compatible service in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project-region>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=datasets

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Largest single request (prompt + completion) the plan allows. Groq's free tier: 8000 tokens/minute.
LLM_REQUEST_TOKEN_BUDGET=7600

# Optional error tracking
# SENTRY_DSN=

# Limits (defaults shown)
# MAX_UPLOAD_MB=20
# MAX_ROWS=250000
# USER_STORAGE_QUOTA_MB=100
# DAILY_ANALYSIS_LIMIT=10
# WORKER_CONCURRENCY=1
