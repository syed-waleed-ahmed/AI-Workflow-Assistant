# Where the Next.js server proxies /api/* to. The browser never calls this URL directly.
# Local development: the FastAPI backend on port 8000.
BACKEND_URL=http://localhost:8000

# Optional. Public origin of the API, used ONLY for dataset uploads.
# Set it in production: the frontend host does not document how large a request body its
# proxy accepts, so the browser requests a short-lived upload ticket through the proxy and
# sends the file straight to this origin with "Authorization: Bearer <ticket>".
# Leave it unset in local development so uploads go through the same-origin proxy.
# NEXT_PUBLIC_API_DIRECT_URL=https://api.example.com
# Optional. Secret shared with the API (its PROXY_SHARED_SECRET). When set, sign-in and
# registration requests forwarded by this app carry the visitor's address, so the API's
# per-address rate limit applies per visitor rather than to the proxy as a whole.
# PROXY_SHARED_SECRET=
